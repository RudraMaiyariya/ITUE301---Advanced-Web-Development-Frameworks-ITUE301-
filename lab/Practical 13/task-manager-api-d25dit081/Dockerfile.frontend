# Practical 11: Frontend Multi-Stage Dockerfile (Supplementary Problem 2)

# ==========================================
# STAGE 1: Build the React Application
# ==========================================
FROM node:18-alpine AS build

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source and build static bundle
COPY . .
RUN npm run build

# ==========================================
# STAGE 2: Lightweight Production Runtime
# Reduces final image size from ~1GB to ~85MB
# ==========================================
FROM node:18-alpine AS production

WORKDIR /app

# Only copy runtime dependencies and built dist output
COPY package*.json ./
RUN npm install --omit=dev

COPY --from=build /app/dist ./dist
COPY vite.config.js ./

# Expose Vite Preview port
EXPOSE 5173

# Serve built bundle across container network
CMD ["npx", "vite", "preview", "--port", "5173", "--host", "0.0.0.0"]
